  <style>
    /* 1. Container configuration to hide page scrollbars */
    .marquee-container {
      width: 100%;
      overflow: hidden;
      white-space: nowrap;
      position: relative;
      background: transparent;
    }

    /* 2. Style your target image and attach the scroll animation */
    .scrolling-hammer {
      width: 900px; /* Forces your larger size preference */
      height: auto;
      display: inline-block;
      animation: scroll-left 15s linear infinite; /* Loops every 15 seconds */
    }

    /* 3. The path layout instructions from off-screen right to off-screen left */
    @keyframes scroll-left {
      0% {
        transform: translateX(100vw); /* Starts outside the right frame */
      }
      100% {
        transform: translateX(-100%); /* Loops after leaving the left frame */
      }
    }
  </style>
</head>
